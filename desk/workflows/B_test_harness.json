  {
   "id": "load-test-set",
   "name": "Load test set",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    240,
    100
   ],
   "parameters": {
    "jsCode": "// the hidden answers stay in this workflow; A only ever sees the message\nconst fs = require('fs'), path = require('path');\nconst cases = JSON.parse(fs.readFileSync(path.join($env.DESK_DIR, '..', 'test_set.json'), 'utf8'));\nreturn cases.map(c => ({ json: c }));\n",
    "mode": "runOnceForAllItems",
    "language": "javaScript"
   }
  },
  {
   "id": "send-to-lead-desk",
   "name": "Send to lead desk",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4.2,
   "position": [
    480,
    100
   ],
   "parameters": {
    "method": "POST",
    "url": "http://127.0.0.1:5678/webhook/lead-desk",
    "sendBody": true,
    "specifyBody": "json",
    "jsonBody": "={{ { message: $json.message, name: $json.name, phone: $json.phone, channel: 'Test harness', test_run: true, as_of: '2026-10' } }}",
    "options": {
     "batching": {
      "batch": {
       "batchSize": 10,
       "batchInterval": 200
      }
     },
     "timeout": 30000
    }
   }
  },
  {
   "id": "score-against-hidden-answers",
   "name": "Score against hidden answers",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    720,
    100
   ],
   "parameters": {
    "jsCode": "const fs = require('fs'), path = require('path');\nconst cases = $('Load test set').all().map(i => i.json);\nconst got = $input.all().map(i => i.json);\nconst rows = cases.map((c, i) => ({ id: c.id, set: c.set, expected: c.truth, got: got[i].tier, ok: got[i].tier === c.truth }));\nconst by = s => { const r = rows.filter(x => x.set === s); return `${r.filter(x => x.ok).length}/${r.length}`; };\nconst report = { ran_at: new Date().toISOString(), cases: rows.length, correct: rows.filter(r => r.ok).length,\n  accuracy_pct: Math.round(1000 * rows.filter(r => r.ok).length / rows.length) / 10,\n  plain_set: by('plain'), stress_set: by('stress'), misses: rows.filter(r => !r.ok),\n  note: 'Rules-only reading (no AI). The published Python baseline is 77/90 (85.6%); the AI model scored 90/90 blind.' };\nfs.writeFileSync(path.join($env.DESK_DIR, 'harness_report.json'), JSON.stringify(report, null, 1));\nreturn [{ json: report }];\n",
    "mode": "runOnceForAllItems",
    "language": "javaScript"
   }
  },
  {
   "id": "came-from-webhook",
   "name": "Came from webhook?",
